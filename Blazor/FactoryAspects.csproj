<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FactoryAspects</RootNamespace>
    <AssemblyName>FactoryAspects</AssemblyName>
    <!-- Declared explicitly (not inherited from a Directory.Build.props, which this
         standalone repo doesn't have) so the project builds/packs identically
         wherever it's cloned. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (missing XML doc comment) would otherwise fail the build for every
         public parameter across every component — this library documents itself via
         README.md + inline comments on the handful of non-obvious parameters (see
         FaToggle's Options/ShowInputWhen), not exhaustive per-member XML docs. Still
         want GenerateDocumentationFile on so the .nupkg ships a (mostly empty) .xml
         doc file rather than none at all. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ============================= Sass build (fa-styles.css) =============================
       fa-styles.css is generated, not checked in — DartSassBuilder compiles
       wwwroot/css/fa-styles.scss (which @uses every partial under wwwroot/css/scss/,
       "theme"/palettes included — fa-styles.scss is deliberately not itself named
       theme.scss, since that name is reserved for the palette/mode partial it pulls
       in, not the all-encompassing root) to wwwroot/css/fa-styles.css on every
       `dotnet build`/`dotnet pack`, no separate tool-install/CI step needed (it's a
       plain build-time PackageReference, not a global CLI tool). EnableDefaultSassItems
       is off and fa-styles.scss is the only explicit <SassFile> so the scss/ partials
       (Sass-partial-convention underscore-prefixed, never compiled standalone) are
       only ever pulled in via fa-styles.scss's @use chain, never compiled to their
       own .css. See Blazor/CLAUDE.md's "Themes" section for the partial layout. -->
  <PropertyGroup>
    <EnableDefaultSassItems>false</EnableDefaultSassItems>
    <DartSassOutputStyle>expanded</DartSassOutputStyle>
  </PropertyGroup>

  <ItemGroup>
    <SassFile Include="wwwroot/css/fa-styles.scss" />
    <PackageReference Include="DartSassBuilder" Version="1.1.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- The .scss sources themselves aren't a static web asset a consumer needs —
       only the compiled fa-styles.css DartSassBuilder produces alongside them is.
       fa-styles.css itself is ALSO removed here (not just the .scss sources) — see
       the comment below for why that removal is load-bearing, not just tidiness. -->
  <ItemGroup>
    <Content Remove="wwwroot/css/fa-styles.scss" />
    <Content Remove="wwwroot/css/scss/**/*.scss" />
    <Content Remove="wwwroot/css/fa-styles.css" />
  </ItemGroup>

  <!-- fa-styles.css is gitignored and regenerated by DartSassBuilder on every build,
       so whether it already exists on disk when MSBuild evaluates the project's
       wildcard wwwroot/** Content-item glob (item globs are captured once, at
       evaluation time, before any target runs) depends entirely on whether this is
       the first build in a fresh checkout or a later one:
        - First build (file doesn't exist yet): the wildcard glob can't see it, so
          without re-adding it below, the generated file never joins @(Content)/
          @(StaticWebAsset) for that build, and the packed .nupkg silently ships no
          CSS at all (confirmed by reproducing a from-clean `dotnet restore` +
          `dotnet pack` 0.4.1 as CI runs it).
        - Any later build (file already exists from the previous one): the wildcard
          glob DOES see it this time, so without the Content Remove above, it's
          picked up twice — once by the wildcard glob, once by this target's own
          Content Include below — and MSBuild's static-web-assets pipeline fails
          outright ("Two assets found targeting the same path with incompatible
          asset kinds") rather than silently duplicating it. Confirmed by hitting
          this for real building a second-and-later time locally, and again via
          DiscoverPrecompressedAssets ("An item with the same key has already been
          added") once bin/obj were also warm.
       The Content Remove above makes the wildcard glob never see this path either
       way, so the target below — hooked to BeforeTargets="AssignTargetPaths", the
       standard MSBuild fix point for generated content in an RCL, since item
       additions inside a target run at execution time rather than evaluation time —
       is the only place that ever adds it, exactly once, for both `dotnet build`
       and `dotnet pack`, on the first build and every one after it. -->
  <Target Name="IncludeGeneratedSassOutput" BeforeTargets="AssignTargetPaths" Condition="Exists('wwwroot/css/fa-styles.css')">
    <ItemGroup>
      <Content Include="wwwroot/css/fa-styles.css" />
    </ItemGroup>
  </Target>

  <!-- ============================= NuGet packaging =============================
       Published to GitHub Packages (https://nuget.pkg.github.com/bencalvin/index.json)
       via .github/workflows/publish.yml on every push to main — not NuGet.org, for now.
       Component/type names keep their existing "Fa" identity (FaButton, FaCard,
       FaToggle<TValue>, FaIcon, ...) — only the package/namespace/repo identity is
       "FactoryAspects"; nothing was renamed at the C# type level during the split
       out of FinanceApp.
       PackageId is pinned on purpose — any consumer's index.html references this
       library's static assets via the RCL convention (_content/FactoryAspects/...),
       which is derived from PackageId at pack time, so changing PackageId without
       updating every _content/FactoryAspects/... reference in every consumer would
       silently 404 the CSS/JS. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FactoryAspects</PackageId>
    <Version>0.4.22</Version>
    <Authors>Ben Calvin</Authors>
    <Description>Self-contained Blazor UI component library — buttons, cards, alerts, badges, modals, a generic N-option toggle, form inputs, page-shell layouts, a theme switcher, and a hand-drawn SVG icon set (all "Fa"-prefixed: FaButton, FaCard, FaToggle, FaIcon, ...). No dependency on any specific app's project or type; built to be reusable as-is in other Blazor apps.</Description>
    <PackageTags>blazor;razor;razorclasslibrary;ui;components</PackageTags>
    <RepositoryUrl>https://github.com/bencalvin/FactoryAspects</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bencalvin/FactoryAspects</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- No PackageLicenseExpression yet — a license hasn't been chosen for this
         library specifically. Set one (e.g. MIT) before actually publishing anywhere
         a consumer outside bencalvin's own accounts would rely on it. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.5" />
  </ItemGroup>

</Project>
