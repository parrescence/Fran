@* Lighter footer band, closes out both page templates. *@

<footer class="fa-footer">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span>&copy; @DateTime.UtcNow.Year @BrandText</span>
    }
</footer>

@code {
    [Parameter] public string BrandText { get; set; } = "FinanceApp";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
