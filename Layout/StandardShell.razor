@* Template 1: header + content + footer, no sidebar. For pages that don't need
   app navigation alongside them (landing/marketing pages, standalone flows). *@

<div class="fa-shell fa-shell-standard">
    <AppHeader BrandText="@BrandText"
               BrandHref="@BrandHref"
               IsAuthenticated="@IsAuthenticated"
               UserDisplayName="@UserDisplayName"
               UserImageUrl="@UserImageUrl"
               OnLogin="OnLogin"
               OnLogout="OnLogout" />

    <main class="fa-shell-main">
        @ChildContent
    </main>

    <AppFooter BrandText="@BrandText">@FooterContent</AppFooter>
</div>

@code {
    [Parameter, EditorRequired] public string BrandText { get; set; } = "";
    [Parameter] public string BrandHref { get; set; } = "";
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public string? UserDisplayName { get; set; }
    [Parameter] public string? UserImageUrl { get; set; }
    [Parameter] public EventCallback OnLogin { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
}
