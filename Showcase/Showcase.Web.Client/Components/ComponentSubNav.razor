@* Shared cross-nav for a component's split demo pages — "How to use" (the
   original page, at BaseRoute unchanged so existing links/bookmarks keep
   working), "API" (BaseRoute/api), and "Wiring up" (BaseRoute/wiring) for the
   handful of components that need real setup beyond the standard package
   install (DI registration, an ItemsProvider, etc.) — most don't, so
   ShowWiring defaults to false. Not part of the FaFa style library itself,
   same category as DemoPageHeader.razor (Showcase's own app-internal
   plumbing). Validation has its own ValidationSubNav instead of this one —
   it's a cross-cutting concept page with its own index, not "one component's
   demo split into sub-pages". *@

<nav class="component-subnav">
    @if (ShowWiring)
    {
        <NavLink class="component-subnav-link" href="@($"{BaseRoute}/wiring")">Wiring up</NavLink>
    }
    <NavLink class="component-subnav-link" href="@BaseRoute" Match="NavLinkMatch.All">How to use</NavLink>
    <NavLink class="component-subnav-link" href="@($"{BaseRoute}/api")">API</NavLink>
</nav>

@code {
    /// <summary>The component's existing demo route, e.g. "/fa-button" — stays the "How to use" page.</summary>
    [Parameter, EditorRequired] public string BaseRoute { get; set; } = "";
    /// <summary>Shows the "Wiring up" tab (BaseRoute/wiring) — only for components that need real setup beyond the standard package install.</summary>
    [Parameter] public bool ShowWiring { get; set; }
}
