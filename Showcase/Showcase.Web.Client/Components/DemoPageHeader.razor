@* Shared header for every "one page per component" demo page — the PageTitle/h1/
   intro-paragraph-with-a-docs-link block every Pages/<Category>/Fa*Page.razor
   repeats verbatim except for three values. Not part of the Fran style library
   itself (Blazor/'s own CLAUDE.md rule against markup-authored components doesn't
   apply here — that rule is for the published package; this is Showcase's own
   app-internal plumbing, same category as PaletteDetail.razor). *@

<PageTitle>@Title — Fran Showcase</PageTitle>

<h1>@Title</h1>
<p class="fa-mb-4">
    <code>@ComponentName</code>. Full parameter reference:
    <a href="https://github.com/parrescence/Fran/blob/dev/Blazor/docs/@(DocSlug).md" target="_blank">Blazor/docs/@(DocSlug).md</a>.
    @ChildContent
</p>

@code {
    /// <summary>Page heading — also becomes the browser tab title, "@Title — Fran Showcase".</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    /// <summary>The component tag name shown in code font, e.g. "FaButton" or "FaTabs&lt;TValue&gt;".</summary>
    [Parameter, EditorRequired] public string ComponentName { get; set; } = "";
    /// <summary>Filename (no extension) under Blazor/docs/ this component's full reference lives at, e.g. "fa-button".</summary>
    [Parameter, EditorRequired] public string DocSlug { get; set; } = "";
    /// <summary>Extra sentence(s) appended after the doc link — what makes this component worth reaching for, a binding-shape note, etc.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
