@page "/fa-helix-loader"

<PageTitle>Helix Loader — FaFa Showcase</PageTitle>

<h1>Helix Loader</h1>
<p class="fa-mb-4">
    <code>FaHelixLoader</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-helix-loader.md" target="_blank">Blazor/docs/fa-helix-loader.md</a>.
    Twisting, breathing DNA-helix dots.
</p>

<div class="fa-demo-preview">
    <FaHelixLoader />
    <FaHelixLoader RungCount="3" Variant="FaLoaderVariant.Primary" />
</div>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Base (default)</span><code>.fa-helix-loader</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Variant="Primary"</span><code>.fa-helix-loader.fa-loader-primary</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Each rung</span><code>.fa-helix-rung</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Dot</span><code>.fa-helix-dot-top</code> / <code>.fa-helix-dot-bottom</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaHelixLoader /&gt;
&lt;FaHelixLoader RungCount="3" Variant="FaLoaderVariant.Primary" /&gt;</code></div>
