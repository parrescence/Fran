@page "/fa-file"

<PageTitle>File Upload — FaFa Showcase</PageTitle>

<h1>File Upload</h1>
<p class="fa-mb-4">
    <code>FaFile</code>. Full parameter reference: <a href="https://github.com/benzaesintese/FaFa/blob/dev/Blazor/docs/fa-file.md" target="_blank">Blazor/docs/fa-file.md</a>.
    <code>AsButton</code> switches which classes render — a real file input, styled as a button, versus a plain
    file input.
</p>

<div class="fa-demo-preview">
    <FaFile AsButton="true" ButtonLabel="Upload receipt" OnChange="HandleFileSelectedAsync" />
</div>
@if (_lastFileName is not null)
{
    <p>Selected: <FaBadge>@_lastFileName</FaBadge></p>
}
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">AsButton="true"</span><code>.fa-btn.fa-btn-secondary</code> (input hidden via <code>.fa-file-hidden</code>)</div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">AsButton="false" (default)</span><code>.fa-file-input</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaFile AsButton="true" ButtonLabel="Upload receipt" OnChange="HandleFileSelectedAsync" /&gt;

@@code {
    private Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var fileName = e.File.Name;
        return Task.CompletedTask;
    }
}</code></div>

@code {
    private string? _lastFileName;

    private Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _lastFileName = e.File.Name;
        return Task.CompletedTask;
    }
}
