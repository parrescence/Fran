@page "/forms"
@inject HttpClient Http

<PageTitle>Self-contained forms — FactoryAspects Showcase</PageTitle>

<h1>Self-contained forms</h1>

<h2>FaForm&lt;TModel&gt;</h2>
<p>
    Mode toggles between "new" and "update" — same component either way, just a
    different submit label and whether Delete shows.
</p>
<div class="fa-row fa-gap-2 fa-mb-3">
    <FaButton Variant="@(_formMode == FaFormMode.Create ? FaButtonVariant.Primary : FaButtonVariant.Outline)" OnClick="@(() => _formMode = FaFormMode.Create)">Create mode</FaButton>
    <FaButton Variant="@(_formMode == FaFormMode.Edit ? FaButtonVariant.Primary : FaButtonVariant.Outline)" OnClick="@(() => _formMode = FaFormMode.Edit)">Edit mode</FaButton>
</div>

<FaForm TModel="ProductModel" Model="_productModel" Mode="_formMode"
        OnSubmit="HandleFormSubmitAsync" OnCancel="@(() => _formResult = "Cancelled.")"
        OnDelete="@(() => _formResult = "Deleted.")" Busy="_formBusy">
    <FaInput TValue="string" @bind-Value="_productModel.Name" Label="Name" Placeholder="Trail Runner Jacket" />
    <FaInput TValue="decimal" @bind-Value="_productModel.Price" Type="number" Step="0.01" Label="Price" />
</FaForm>
@if (_formResult is not null)
{
    <p class="fa-mt-2"><FaBadge Variant="FaBadgeVariant.Success">@_formResult</FaBadge></p>
}

<h2 class="fa-mt-5">FaLoginForm</h2>
<p>
    Really calls <code>POST /api/auth/login</code> on <code>Showcase.Web.Api</code>.
    Try <code>demo</code> / <code>password</code> for success, anything else fails.
</p>
<div style="max-width: 360px;">
    <FaLoginForm OnSubmit="HandleLoginAsync" Busy="_loginBusy" ErrorText="@_loginError" />
</div>
@if (_loginSuccess)
{
    <p class="fa-mt-2"><FaBadge Variant="FaBadgeVariant.Success">Logged in.</FaBadge></p>
}

<h2 class="fa-mt-5">FaLogoutForm</h2>
<FaButton OnClick="@(() => _showLogoutModal = true)">Log out</FaButton>
<FaModal Show="_showLogoutModal" Title="Log out" OnClose="@(() => _showLogoutModal = false)" Size="FaModalSize.Small">
    <FaLogoutForm OnConfirm="HandleLogoutAsync" OnCancel="@(() => _showLogoutModal = false)" />
</FaModal>

@code {
    private sealed class ProductModel
    {
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
    }

    private ProductModel _productModel = new() { Name = "Trail Runner Jacket", Price = 129.99m };
    private FaFormMode _formMode = FaFormMode.Create;
    private bool _formBusy;
    private string? _formResult;

    private async Task HandleFormSubmitAsync(ProductModel model)
    {
        _formBusy = true;
        await Task.Delay(400); // stand-in for a real save call
        _formBusy = false;
        _formResult = $"{(_formMode == FaFormMode.Edit ? "Saved" : "Created")}: {model.Name} ({model.Price:C})";
    }

    private bool _loginBusy;
    private bool _loginSuccess;
    private string? _loginError;

    private async Task HandleLoginAsync(FaLoginRequest request)
    {
        _loginBusy = true;
        _loginError = null;
        var response = await Http.PostAsJsonAsync("/api/auth/login", request);
        var result = await response.Content.ReadFromJsonAsync<LoginResult>();
        _loginBusy = false;
        _loginSuccess = result?.Success ?? false;
        _loginError = result?.Success == true ? null : result?.ErrorMessage ?? "Login failed.";
    }

    private bool _showLogoutModal;

    private Task HandleLogoutAsync()
    {
        _showLogoutModal = false;
        return Task.CompletedTask;
    }

    private sealed record LoginResult(bool Success, string? ErrorMessage);
}
