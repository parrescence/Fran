@namespace Showcase.Web.Client.Pages

@page "/fa-helix-loader/api"

<DemoPageHeader Title="Helix Loader: API" ComponentName="FaHelixLoader" DocSlug="fa-helix-loader" />

<ComponentSubNav BaseRoute="/fa-helix-loader" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>RungCount</code></td><td><code>int</code></td><td>default <code>5</code>; clamped to <code>1</code>–<code>6</code></td></tr>
            <tr><td><code>Variant</code></td><td><code>FaLoaderVariant</code></td><td><code>Accent</code> (default) · <code>Primary</code> · <code>Gold</code> · <code>Danger</code> — shared across every loader component</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above. Purely CSS keyframes; renders <code>role="status" aria-label="Loading"</code> automatically.</p>
