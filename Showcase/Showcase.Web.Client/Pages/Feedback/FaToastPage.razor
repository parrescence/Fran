@namespace Showcase.Web.Client.Pages

@page "/fa-toast"

<DemoPageHeader Title="Toast" ComponentName="FaToastHost + FaToastService" DocSlug="fa-toast">
    The host is mounted once in <code>MainLayout.razor</code> for the whole app; <code>FaToastService</code> is registered once in <code>Program.cs</code> (<code>AddScoped&lt;FaToastService&gt;()</code>) — click below to fire one from here.
</DemoPageHeader>

<div class="fa-demo-preview">
    <FaButton Variant="FaButtonVariant.Primary" OnClick="@(() => ToastService.Show("Order saved", FaAlertVariant.Success))">Success toast</FaButton>
    <FaButton Variant="FaButtonVariant.Secondary" OnClick="@(() => ToastService.Show("New message received"))">Info toast</FaButton>
    <FaButton Variant="FaButtonVariant.Danger" OnClick="@(() => ToastService.Show("Payment failed", FaAlertVariant.Danger))">Danger toast</FaButton>
</div>

<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Toast</span><code>.fa-toast.fa-toast-success</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Host</span><code>.fa-toast-host-top-right</code></div>
</div>
<div class="fa-code-block"><code>@@* Program.cs *@@
builder.Services.AddScoped&lt;FaToastService&gt;();

@@* Anywhere in the app *@@
[Inject] private FaToastService ToastService { get; set; } = default!;
ToastService.Show("Order saved", FaAlertVariant.Success);</code></div>

@code {
    [Inject] private FaToastService ToastService { get; set; } = default!;
}