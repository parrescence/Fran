@namespace Showcase.Web.Client.Pages

@page "/fa-toast/wiring"

<DemoPageHeader Title="Toast: Wiring up" ComponentName="FaToastHost + FaToastService" DocSlug="fa-toast">
    The one component in this library that needs a DI registration — everything
    else is just a tag.
</DemoPageHeader>

<ComponentSubNav BaseRoute="/fa-toast" ShowWiring="true" />

<h2>1. Register the service</h2>
<p><code>Program.cs</code> — scoped so it stays per-user-session on Blazor Server, not that it matters for the WebAssembly hosting model this Showcase uses.</p>
<FaCodeBlock Language="FaCodeLanguage.CSharp" Code="@_registrationSample" />

<h2 class="fa-mt-5">2. Mount the host once</h2>
<p>Typically your root layout — one <code>&lt;FaToastHost /&gt;</code> for the whole app, not one per page.</p>
<FaCodeBlock Language="FaCodeLanguage.Razor" Code="@_hostSample" />

<h2 class="fa-mt-5">3. Fire a toast from anywhere</h2>
<p><code>[Inject]</code> the service in any component and call <code>Show</code> — see it live on the <a href="/fa-toast">How to use</a> page.</p>
<FaCodeBlock Language="FaCodeLanguage.Razor" Code="@_useSample" />

@code {
    private readonly string _registrationSample = """
        builder.Services.AddScoped<FaToastService>();
        """;

    private readonly string _hostSample = """
        <FaToastHost Position="FaToastPosition.TopRight" />
        """;

    private readonly string _useSample = """
        @code {
            [Inject] private FaToastService ToastService { get; set; } = default!;

            private async Task Save()
            {
                await SaveOrderAsync();
                ToastService.Show("Order saved", FaAlertVariant.Success);
            }
        }
        """;
}
