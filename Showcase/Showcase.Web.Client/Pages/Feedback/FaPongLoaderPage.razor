    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Paddles</span><code>.fa-pong-paddle-left</code> / <code>.fa-pong-paddle-right</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Ball</span><code>.fa-pong-ball</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaPongLoader /&gt;
&lt;FaPongLoader Variant="FaLoaderVariant.Gold" /&gt;</code></div>