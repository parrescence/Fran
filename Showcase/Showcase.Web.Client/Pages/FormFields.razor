@page "/form-fields"

<PageTitle>Form fields — FactoryAspects Showcase</PageTitle>

<h1>Form fields</h1>
<p class="fa-mb-4">
    <code>FaInput</code>/<code>FaSelect</code>/<code>FaTextarea</code>/<code>FaCheckbox</code>/
    <code>FaDatePicker</code>/<code>FaCurrency</code> are <code>InputBase&lt;TValue&gt;</code>-derived,
    so they only work inside an <code>&lt;EditForm&gt;</code> — everything else here
    (<code>FaToggle</code>, <code>FaRadioGroup</code>, <code>FaSearchSelect</code>,
    <code>FaDropdown</code>, <code>FaDateRange</code>) uses a plain
    <code>@@bind-Value</code> and works with or without one.
</p>

<EditForm Model="_model" class="fa-form">
    <FaInput TValue="string" @bind-Value="_model.Name" Label="Name" Placeholder="Jane Doe" />
    <FaInput TValue="decimal" @bind-Value="_model.Amount" Type="number" Step="0.01" Label="Amount" />

    <FaSelect TValue="string" @bind-Value="_model.Type" Label="Type">
        <option value="">Choose…</option>
        <option value="general">General</option>
        <option value="urgent">Urgent</option>
    </FaSelect>

    <FaTextarea @bind-Value="_model.Notes" Label="Notes" MaxLength="280" />

    <FaCheckbox @bind-Value="_model.Subscribe" Label="Subscribe to updates" />

    <FaDatePicker @bind-Value="_model.Date" Label="Start date" Max="DateOnly.FromDateTime(DateTime.Today)" />

    <FaCurrency @bind-Value="_model.Budget" Label="Budget" Min="0" />
</EditForm>

<h2 class="fa-mt-5">FaToggle</h2>
<FaToggle TValue="string" Label="Billing period" Options="_periodOptions" @bind-Value="_period" />
<p>Selected: <FaBadge>@_period</FaBadge></p>

<h3>With a companion input</h3>
<FaToggle TValue="string" Label="Amount" Options="_amountOptions" @bind-Value="_amountMode"
          InputType="number" InputPlaceholder="Enter amount"
          ShowInputWhen="@(mode => mode == "custom")" @bind-InputValue="_customAmountText" />

<h2 class="fa-mt-5">FaRadioGroup</h2>
<FaRadioGroup TValue="string" Label="Frequency" Options="_frequencyOptions" @bind-Value="_frequency" />
<p>Selected: <FaBadge>@_frequency</FaBadge></p>

<h2 class="fa-mt-5">FaSearchSelect</h2>
<p>Type-to-search over an in-memory list (a real app would query a service/API instead).</p>
<FaSearchSelect TItem="string" Label="Product" Placeholder="Type a product name…"
                QueryAsync="SearchProductsAsync" ItemLabel="p => p" @bind-Value="_selectedProduct" />
<p>Selected: <FaBadge>@(_selectedProduct ?? "(none)")</FaBadge></p>

<h2 class="fa-mt-5">FaDropdown</h2>
<FaDropdown TItem="string" Label="Product (windowed dropdown)" Placeholder="Type to filter…"
            Items="_productNames" ItemLabel="p => p" @bind-Value="_dropdownProduct" />

<h2 class="fa-mt-5">FaDateRange</h2>
<FaDateRange Label="Date range" @bind-Value="_range" />
<p>Showing @_range.From?.ToString("MMM d") – @_range.To?.ToString("MMM d")</p>

<h2 class="fa-mt-5">FaFile</h2>
<FaFile AsButton="true" ButtonLabel="Upload receipt" OnChange="HandleFileSelectedAsync" />
@if (_lastFileName is not null)
{
    <p>Selected: <FaBadge>@_lastFileName</FaBadge></p>
}

@code {
    private class DemoModel
    {
        public string Name { get; set; } = "";
        public decimal Amount { get; set; }
        public string Type { get; set; } = "";
        public string? Notes { get; set; }
        public bool Subscribe { get; set; }
        public DateOnly? Date { get; set; }
        public decimal? Budget { get; set; }
    }

    private DemoModel _model = new();

    private string _period = "monthly";
    private IReadOnlyList<(string Title, string Value)> _periodOptions = new[]
    {
        ("Monthly", "monthly"),
        ("Yearly", "yearly")
    };

    private string _amountMode = "default";
    private string? _customAmountText;
    private IReadOnlyList<(string Title, string Value)> _amountOptions = new[]
    {
        ("Default", "default"),
        ("Custom", "custom")
    };

    private string _frequency = "monthly";
    private IReadOnlyList<(string Title, string Value)> _frequencyOptions = new[]
    {
        ("Weekly", "weekly"),
        ("Monthly", "monthly"),
        ("Yearly", "yearly")
    };

    private readonly List<string> _productNames = new()
    {
        "Trail Runner Jacket", "Cedar Camp Mug", "Alpine Wool Socks", "Folding Camp Stool",
        "Rain Shell, Packable", "Titanium Spork", "Wool Beanie", "Camp Lantern, Solar",
        "Merino Base Layer", "Insulated Water Bottle", "Trekking Poles, Pair", "Fleece Vest"
    };

    private string? _selectedProduct;
    private string? _dropdownProduct;

    private Task<IReadOnlyList<string>> SearchProductsAsync(string query) =>
        Task.FromResult<IReadOnlyList<string>>(
            _productNames.Where(p => p.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList());

    private FaDateRangeValue _range = new(
        DateOnly.FromDateTime(DateTime.Today.AddMonths(-1)),
        DateOnly.FromDateTime(DateTime.Today));

    private string? _lastFileName;

    private Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _lastFileName = e.File.Name;
        return Task.CompletedTask;
    }
}
