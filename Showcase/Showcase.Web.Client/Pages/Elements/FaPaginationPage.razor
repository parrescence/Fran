@namespace Showcase.Web.Client.Pages

@page "/fa-pagination"

<DemoPageHeader Title="Pagination" ComponentName="FaPagination" DocSlug="fa-pagination">
    Standalone — <code>FaGrid</code> pages its own data internally and doesn't use this component.
</DemoPageHeader>

<FaPagination CurrentPage="_page" PageCount="12" OnPageChange="@(page => _page = page)" />
<p>Page <FaBadge>@_page</FaBadge> of 12</p>

<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Page (active)</span><code>.fa-pagination-page.fa-pagination-page-active</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Prev/next</span><code>.fa-pagination-nav</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaPagination CurrentPage="_page" PageCount="12" OnPageChange="@@(page =&gt; _page = page)" /&gt;</code></div>

@code {
    private int _page = 1;
}