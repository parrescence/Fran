@namespace Showcase.Web.Client.Pages

@page "/fa-avatar/api"

<DemoPageHeader Title="Avatars: API" ComponentName="FaAvatar" DocSlug="fa-avatar" />

<ComponentSubNav BaseRoute="/fa-avatar" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>DisplayName</code></td><td><code>string?</code></td><td>drives the initials fallback and the <code>title</code>/<code>alt</code> text</td></tr>
            <tr><td><code>ImageUrl</code></td><td><code>string?</code></td><td>shows a photo instead of initials when set</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above.</p>
