@namespace Showcase.Web.Client.Pages

@page "/fa-card"

<DemoPageHeader Title="Cards" ComponentName="FaCard" DocSlug="fa-card" />

<h2>Clickable + active</h2>
<p><code>Clickable</code> makes it focusable/tabbable; <code>Active</code> adds a distinct border for a selectable tile grid.</p>
<div class="fa-demo-preview">
    @foreach (var option in _cardOptions)
    {
        <FaCard CssClass="fa-col-auto" Clickable="true" Active="@(_selectedCard == option)" OnClick="@(() => _selectedCard = option)">
            <strong>@option</strong>
        </FaCard>
    }
</div>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Base</span><code>.fa-card</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Active</span><code>.fa-card.fa-card-active</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaCard Clickable="true" Active="@@(_selected == "Pro")" OnClick="@@(() => _selected = "Pro")"&gt;
    &lt;strong&gt;Pro&lt;/strong&gt;
&lt;/FaCard&gt;</code></div>

@code {
    private readonly string[] _cardOptions = { "Starter", "Pro", "Enterprise" };
    private string _selectedCard = "Pro";
}