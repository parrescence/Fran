@namespace Showcase.Web.Client.Pages

@page "/fa-badge"

<DemoPageHeader Title="Badges" ComponentName="FaBadge" DocSlug="fa-badge" />

<ComponentSubNav BaseRoute="/fa-badge" />

<h2>Variants</h2>
<div class="fa-demo-preview">
    <FaBadge Variant="FaBadgeVariant.Neutral">Neutral</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary">Primary</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Success">Paid</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Danger">Overdue</FaBadge>
</div>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Neutral (default)</span><code>.fa-badge</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Primary</span><code>.fa-badge.fa-badge-primary</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Success</span><code>.fa-badge.fa-badge-success</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Danger</span><code>.fa-badge.fa-badge-danger</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaBadge Variant="FaBadgeVariant.Success"&gt;Paid&lt;/FaBadge&gt;
&lt;FaBadge Variant="FaBadgeVariant.Danger"&gt;Overdue&lt;/FaBadge&gt;</code></div>

<h2 class="fa-mt-5">Size</h2>
<p><code>Size</code> is the shared <a href="/sizing">FaSize</a> scale — <code>Medium</code> (default) renders with no extra class.</p>
<div class="fa-demo-preview">
    <FaBadge Variant="FaBadgeVariant.Primary" Size="FaSize.XSmall">XSmall</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary" Size="FaSize.Small">Small</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary">Medium</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary" Size="FaSize.Large">Large</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary" Size="FaSize.XLarge">XLarge</FaBadge>
</div>
<div class="fa-code-block"><code>&lt;FaBadge Variant="FaBadgeVariant.Primary" Size="FaSize.Small"&gt;Small&lt;/FaBadge&gt;</code></div>