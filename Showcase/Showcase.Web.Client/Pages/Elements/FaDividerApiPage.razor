@namespace Showcase.Web.Client.Pages

@page "/fa-divider/api"

<DemoPageHeader Title="Divider: API" ComponentName="FaDivider" DocSlug="fa-divider" />

<ComponentSubNav BaseRoute="/fa-divider" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td>splits the rule around a short label — ignored when <code>Vertical</code> is <code>true</code></td></tr>
            <tr><td><code>Vertical</code></td><td><code>bool</code></td><td>divides side-by-side content instead of stacked content</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above.</p>
