@namespace Showcase.Web.Client.Pages

@page "/fa-code-block"

<DemoPageHeader Title="Code Block" ComponentName="FaCodeBlock" DocSlug="fa-code-block">
    Read-only, language-labeled, lightly syntax-highlighted — no third-party highlighting library. Background is <code>var(--fa-fir)</code>, so it's always a darker panel than the page around it, in every palette.
</DemoPageHeader>

<ComponentSubNav BaseRoute="/fa-code-block" />

<h2>Pick a language</h2>
<div class="fa-demo-preview">
    @* Plain native &lt;select&gt; with @@bind, not &lt;FaSelect&gt; — FaSelect is
       InputBase&lt;TValue&gt;-derived and only works inside an EditForm/EditContext
       (Blazor/CLAUDE.md), which this simple language picker doesn't need. *@
    <select class="fa-select" style="max-width: 14rem;" @bind="_language">
        @foreach (var lang in Enum.GetValues<FaCodeLanguage>())
        {
            <option value="@lang">@lang</option>
        }
    </select>
</div>
<div class="fa-demo-preview">
    <FaCodeBlock Language="_language" Code="@CurrentSample" />
</div>
<div class="fa-code-block"><code>&lt;FaCodeBlock Language="FaCodeLanguage.@_language" Code="@@_snippet" /&gt;</code></div>

<h2 class="fa-mt-5">Without the copy button</h2>
<div class="fa-demo-preview">
    <FaCodeBlock Language="FaCodeLanguage.Json" Code="@_jsonSample" Copyable="false" />
</div>
<div class="fa-code-block"><code>&lt;FaCodeBlock Language="FaCodeLanguage.Json" Code="@@_json" Copyable="false" /&gt;</code></div>

@code {
    private FaCodeLanguage _language = FaCodeLanguage.CSharp;

    private string CurrentSample => _language switch
    {
        FaCodeLanguage.CSharp => _csharpSample,
        FaCodeLanguage.Html => _htmlSample,
        FaCodeLanguage.Json => _jsonSample,
        FaCodeLanguage.Sql => _sqlSample,
        FaCodeLanguage.Bash => _bashSample,
        _ => _plainSample
    };

    private readonly string _csharpSample = """
        public class Greeter
        {
            // Says hello, nothing fancier than that.
            public string Greet(string name) => $"Hello, {name}!";
        }
        """;

    private readonly string _htmlSample = """
        <div class="card" data-id="42">
          <!-- rendered by FaCard -->
          <span>Hello</span>
        </div>
        """;

    private readonly string _jsonSample = """
        {
          "name": "Ben",
          "age": 42,
          "active": true
        }
        """;

    private readonly string _sqlSample = "SELECT * FROM users WHERE active = 1 -- only active rows";

    private readonly string _bashSample = """
        # deploy the app
        if [ -f build.zip ]; then
          echo "deploying..."
        fi
        """;

    private readonly string _plainSample = "Pick a language above to see it highlighted.";
}
