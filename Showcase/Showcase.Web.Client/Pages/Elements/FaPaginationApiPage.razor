@namespace Showcase.Web.Client.Pages

@page "/fa-pagination/api"

<DemoPageHeader Title="Pagination: API" ComponentName="FaPagination" DocSlug="fa-pagination" />

<ComponentSubNav BaseRoute="/fa-pagination" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>CurrentPage</code></td><td><code>int</code></td><td>default <code>1</code> — not two-way bound, see <code>OnPageChange</code></td></tr>
            <tr><td><code>PageCount</code></td><td><code>int</code></td><td>required</td></tr>
            <tr><td><code>OnPageChange</code></td><td><code>EventCallback&lt;int&gt;</code></td><td>fires with the page the user picked; update your own <code>CurrentPage</code> state in the handler — FaGrid pages its own data internally and doesn't use this component</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above.</p>
