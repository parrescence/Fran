@page "/fa-avatar"

<PageTitle>Avatars — FaFa Showcase</PageTitle>

<h1>Avatars</h1>
<p class="fa-mb-4">
    <code>FaAvatar</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-avatar.md" target="_blank">Blazor/docs/fa-avatar.md</a>.
    No variants — one class, <code>.fa-avatar</code>, whether it shows a photo or falls back to initials.
</p>

<div class="fa-demo-preview">
    <FaAvatar DisplayName="Jane Doe" />
    <FaAvatar DisplayName="A" />
    <FaAvatar />
</div>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Base</span><code>.fa-avatar</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaAvatar DisplayName="Jane Doe" /&gt;
&lt;FaAvatar ImageUrl="/img/jane.jpg" DisplayName="Jane Doe" /&gt;</code></div>
