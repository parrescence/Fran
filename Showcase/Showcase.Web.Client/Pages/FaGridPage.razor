@page "/fa-grid"
@inject HttpClient Http

<PageTitle>Data Grid — FaFa Showcase</PageTitle>

<h1>Data Grid</h1>
<p class="fa-mb-4">
    <code>FaGrid</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-grid.md" target="_blank">Blazor/docs/fa-grid.md</a>.
    A table with its own paging/rows-per-page/sort/filter, in-memory or provider-backed.
</p>

<h2><code>Items</code> (in-memory)</h2>
<p>Client-side paging/sort/filter over a local list.</p>
<FaGrid TItem="Product" Items="_localProducts" Columns="_gridColumns" PageSize="5" />
<div class="fa-code-block"><code>&lt;FaGrid TItem="Product" Items="_products" Columns="_columns" PageSize="5" /&gt;

@@code {
    private IReadOnlyList&lt;FaGridColumn&lt;Product&gt;&gt; _columns = new[]
    {
        new FaGridColumn&lt;Product&gt;
        {
            Header = "Name",
            Sortable = true,
            SortKey = p =&gt; p.Name,
            CellContent = p =&gt; @@&lt;span&gt;@@p.Name&lt;/span&gt;
        }
    };
}</code></div>

<h2 class="fa-mt-5"><code>ItemsProvider</code> (from the database)</h2>
<p>
    Every page/sort/filter change calls <code>GET /api/products/page</code> on
    <code>Showcase.Web.Api</code> — a real HTTP round trip, not a local list.
</p>
<FaGrid TItem="Product" ItemsProvider="LoadProductPageAsync" Columns="_gridColumns" PageSize="5" />
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Grid wrapper</span><code>.fa-grid</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Table</span><code>.fa-table</code> (nested inside)</div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Sort button</span><code>.fa-grid-sort-btn</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Filter row</span><code>.fa-grid-filter-row</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Pagination</span><code>.fa-grid-pagination</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaGrid TItem="Product" ItemsProvider="LoadProductPageAsync" Columns="_columns" PageSize="5" /&gt;

@@code {
    private async Task&lt;FaGridResult&lt;Product&gt;&gt; LoadProductPageAsync(FaGridRequest request)
    {
        var result = await Http.GetFromJsonAsync&lt;ProductPageResult&gt;(
            $"/api/products/page?pageIndex={request.PageIndex}&amp;pageSize={request.PageSize}");
        return new FaGridResult&lt;Product&gt; { Items = result!.Items, TotalCount = result.TotalCount };
    }
}</code></div>

<h2 class="fa-mt-5">Custom <code>LoadingContent</code></h2>
<p>
    The overlay shown while an <code>ItemsProvider</code> request is in flight
    defaults to <code>FaLoadingDots</code> — pass <code>LoadingContent</code> to swap
    in anything else, here an <code>FaSpinner</code>.
</p>
<FaGrid TItem="Product" ItemsProvider="LoadProductPageAsync" Columns="_gridColumns" PageSize="5">
    <LoadingContent><FaSpinner /></LoadingContent>
</FaGrid>
<div class="fa-code-block"><code>&lt;FaGrid TItem="Product" ItemsProvider="LoadProductPageAsync" Columns="_columns" PageSize="5"&gt;
    &lt;LoadingContent&gt;&lt;FaSpinner /&gt;&lt;/LoadingContent&gt;
&lt;/FaGrid&gt;</code></div>

@code {
    private sealed record Product(int Id, string Name, string Category, decimal Price, bool InStock);

    private readonly List<Product> _localProducts = new()
    {
        new(1, "Trail Runner Jacket", "Apparel", 129.99m, true),
        new(2, "Cedar Camp Mug", "Outdoor", 18.50m, true),
        new(3, "Alpine Wool Socks", "Apparel", 14.00m, true),
        new(4, "Folding Camp Stool", "Outdoor", 42.00m, false),
        new(5, "Rain Shell, Packable", "Apparel", 89.00m, true),
        new(6, "Titanium Spork", "Outdoor", 9.99m, true),
        new(7, "Wool Beanie", "Apparel", 22.00m, true),
    };

    private IReadOnlyList<FaGridColumn<Product>> _gridColumns = null!;

    protected override void OnInitialized()
    {
        _gridColumns = new[]
        {
            new FaGridColumn<Product>
            {
                Header = "Name",
                Sortable = true,
                SortKey = p => p.Name,
                CellContent = p => @<span>@p.Name</span>
            },
            new FaGridColumn<Product>
            {
                Header = "Price",
                Sortable = true,
                SortKey = p => p.Price,
                CellContent = p => @<span>@p.Price.ToString("C")</span>
            },
            new FaGridColumn<Product>
            {
                Header = "Status",
                FilterOptions = new[] { ("in-stock", "In stock"), ("out-of-stock", "Out of stock") },
                FilterPredicate = (p, key) => key == "in-stock" ? p.InStock : !p.InStock,
                CellContent = p => @<FaBadge Variant="@(p.InStock ? FaBadgeVariant.Success : FaBadgeVariant.Danger)">
                                       @(p.InStock ? "In stock" : "Out of stock")
                                   </FaBadge>
            }
        };
    }

    private async Task<FaGridResult<Product>> LoadProductPageAsync(FaGridRequest request)
    {
        var statusFilter = request.Filters.GetValueOrDefault("Status");
        var url = $"/api/products/page?pageIndex={request.PageIndex}&pageSize={request.PageSize}" +
                   $"&sortKey={request.SortKey}&sortAscending={request.SortAscending}&statusFilter={statusFilter}";

        var result = await Http.GetFromJsonAsync<ProductPageResult>(url);
        return new FaGridResult<Product>
        {
            Items = result!.Items,
            TotalCount = result.TotalCount
        };
    }

    private sealed record ProductPageResult(List<Product> Items, int TotalCount);
}
