@namespace Showcase.Web.Client.Pages

@page "/fa-home-template/api"
@layout EmptyLayout

<PageTitle>FaHomeTemplate: API — FaFa Showcase</PageTitle>

<a href="/" class="fa-template-demo-back">← Back to Showcase</a>
<ComponentSubNav BaseRoute="/fa-home-template" />

<div style="max-width: 900px; margin: 0 auto; padding: 5rem 1.5rem 2rem;">
    <h1>FaHomeTemplate: API</h1>
    <p>Shell-level parameters (<code>BrandText</code> through <code>FooterPosition</code>) pass straight through to <code>FaStandardShell</code> — see <a href="/layout-shells/api">Layout Shells: API</a>.</p>
    <div class="table-wrap">
        <table class="fa-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
            <tbody>
                <tr><td><code>BrandText</code></td><td><code>string</code></td><td>required</td></tr>
                <tr><td><code>BrandHref</code></td><td><code>string</code></td><td></td></tr>
                <tr><td><code>BrandIconUrl</code></td><td><code>string?</code></td><td>optional logo shown left of <code>BrandText</code></td></tr>
                <tr><td><code>IsAuthenticated</code></td><td><code>bool</code></td><td></td></tr>
                <tr><td><code>UserDisplayName</code> / <code>UserImageUrl</code></td><td><code>string?</code></td><td></td></tr>
                <tr><td><code>OnLogin</code> / <code>OnLogout</code></td><td><code>EventCallback</code></td><td></td></tr>
                <tr><td><code>FooterContent</code></td><td><code>RenderFragment?</code></td><td></td></tr>
                <tr><td><code>HeaderPosition</code> / <code>FooterPosition</code></td><td><code>FaNavPosition</code></td><td>each default <code>Standard</code></td></tr>
                <tr><td><code>HeroTitle</code></td><td><code>string?</code></td><td>built-in hero band's heading</td></tr>
                <tr><td><code>HeroDescription</code></td><td><code>string?</code></td><td></td></tr>
                <tr><td><code>HeroActions</code></td><td><code>RenderFragment?</code></td><td>typically one or two <code>FaButton</code>s</td></tr>
                <tr><td><code>Hero</code></td><td><code>RenderFragment?</code></td><td>full replacement for the built-in hero band — wins over <code>HeroTitle</code>/<code>HeroDescription</code>/<code>HeroActions</code> when set</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>whatever comes after the hero — feature sections, a pricing table, testimonials, etc.</td></tr>
            </tbody>
        </table>
    </div>
</div>
