@namespace Showcase.Web.Client.Pages

@page "/fa-auth-template/api"
@layout EmptyLayout

<PageTitle>FaAuthTemplate: API — Fran Showcase</PageTitle>

<a href="/" class="fa-template-demo-back">← Back to Showcase</a>
<ComponentSubNav BaseRoute="/fa-auth-template" />

<div style="max-width: 900px; margin: 0 auto; padding: 5rem 1.5rem 2rem;">
    <h1>FaAuthTemplate: API</h1>
    <div class="table-wrap">
        <table class="fa-table">
            <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
            <tbody>
                <tr><td><code>BrandText</code></td><td><code>string</code></td><td>required</td></tr>
                <tr><td><code>BrandHref</code></td><td><code>string</code></td><td></td></tr>
                <tr><td><code>BrandIconUrl</code></td><td><code>string?</code></td><td>optional logo shown left of <code>BrandText</code></td></tr>
                <tr><td><code>Title</code></td><td><code>string?</code></td><td>card heading</td></tr>
                <tr><td><code>Description</code></td><td><code>string?</code></td><td></td></tr>
                <tr><td><code>MaxWidth</code></td><td><code>string</code></td><td>default <code>"24rem"</code> — any valid CSS width for the centered card</td></tr>
                <tr><td><code>ChildContent</code></td><td><code>RenderFragment?</code></td><td>the form itself — typically <code>FaLoginForm</code>/<code>FaLogoutForm</code> or your own <code>EditForm</code></td></tr>
                <tr><td><code>FooterContent</code></td><td><code>RenderFragment?</code></td><td>small content below the card — a "Sign up instead" link, terms text, etc.</td></tr>
            </tbody>
        </table>
    </div>
    <p>
        Deliberately chrome-free — no <code>FaHeader</code>/<code>FaSidebar</code>/
        <code>FaFooter</code> at all. Reach for
        <a href="/fa-form-template/api">FaFormTemplate</a> instead when the page
        should keep the site's normal header/footer around the form.
    </p>
</div>
