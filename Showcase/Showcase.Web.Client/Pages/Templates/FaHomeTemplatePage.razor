@namespace Showcase.Web.Client.Pages

@page "/fa-home-template"
@layout EmptyLayout

<PageTitle>FaHomeTemplate — FaFa Showcase</PageTitle>

<a href="/" class="fa-template-demo-back">← Back to Showcase</a>
<ComponentSubNav BaseRoute="/fa-home-template" />

<FaHomeTemplate BrandText="FaFa Showcase" BrandHref="/fa-home-template"
               HeroTitle="Run your business without the spreadsheet"
               HeroDescription="Invoicing, budgets, and reports in one place.">
    <HeroActions>
        <FaButton Variant="FaButtonVariant.Primary">Get started</FaButton>
        <FaButton Variant="FaButtonVariant.Secondary">See pricing</FaButton>
    </HeroActions>
    <ChildContent>
        <p class="fa-template-demo-note fa-text-center">
            A real, live <code>FaHomeTemplate</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-home-template.md" target="_blank">Blazor/docs/fa-home-template.md</a>.
        </p>
        <div class="fa-row fa-gap-3 fa-mt-5">
            <FaCard CssClass="fa-col-auto" style="min-width:16rem;">
                <h3>Invoicing</h3>
                <p>Send and track invoices in minutes.</p>
            </FaCard>
            <FaCard CssClass="fa-col-auto" style="min-width:16rem;">
                <h3>Budgets</h3>
                <p>Set limits per category, get alerted before you're over.</p>
            </FaCard>
            <FaCard CssClass="fa-col-auto" style="min-width:16rem;">
                <h3>Reports</h3>
                <p>Month-over-month trends without a spreadsheet.</p>
            </FaCard>
        </div>
    </ChildContent>
</FaHomeTemplate>