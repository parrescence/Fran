@namespace Showcase.Web.Client.Pages

@page "/fa-form-template"
@layout EmptyLayout

<PageTitle>FaFormTemplate — FaFa Showcase</PageTitle>

<a href="/" class="fa-template-demo-back">← Back to Showcase</a>
<ComponentSubNav BaseRoute="/fa-form-template" />

<FaFormTemplate BrandText="FaFa Showcase" BrandHref="/fa-form-template"
               Title="Invite a teammate"
               Description="They'll get an email with a link to join."
               BackHref="/" BackText="Back to Showcase">
    <p class="fa-template-demo-note fa-mb-3">
        A real, live <code>FaFormTemplate</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-form-template.md" target="_blank">Blazor/docs/fa-form-template.md</a>.
    </p>
    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <FaInput @bind-Value="_model.Email" Label="Email" Placeholder="teammate@example.com" />
        <FaButton Variant="FaButtonVariant.Primary" CssClass="fa-mt-3">Send invite</FaButton>
    </EditForm>
</FaFormTemplate>

@code {
    private class InviteModel
    {
        public string Email { get; set; } = "";
    }

    private InviteModel _model = new();

    private void HandleSubmitAsync() { /* demo only */ }
}