@page "/buttons-feedback"

<PageTitle>Buttons & feedback — FactoryAspects Showcase</PageTitle>

<h1>Buttons &amp; feedback</h1>

<h2>FaButton</h2>
<p>Every <code>FaButtonVariant</code>, plus <code>Small</code> and <code>Href</code>.</p>
<div class="fa-row fa-gap-2 fa-mb-3">
    <FaButton Variant="FaButtonVariant.Primary">Primary</FaButton>
    <FaButton Variant="FaButtonVariant.Secondary">Secondary</FaButton>
    <FaButton Variant="FaButtonVariant.Outline">Outline</FaButton>
    <FaButton Variant="FaButtonVariant.Accent">Accent</FaButton>
    <FaButton Variant="FaButtonVariant.OutlineAccent">Outline accent</FaButton>
    <FaButton Variant="FaButtonVariant.Danger">Danger</FaButton>
    <FaButton Variant="FaButtonVariant.OutlineDanger">Outline danger</FaButton>
    <FaButton Variant="FaButtonVariant.Primary" Small="true">Small</FaButton>
    <FaButton Variant="FaButtonVariant.Primary" Disabled="true">Disabled</FaButton>
    <FaButton Href="https://github.com/bencalvin/FactoryAspects" Target="_blank" Variant="FaButtonVariant.Secondary">Link styled as a button</FaButton>
</div>
<details class="fa-mb-4">
    <summary>Code</summary>
    <pre><code>&lt;FaButton Variant="FaButtonVariant.Primary"&gt;Primary&lt;/FaButton&gt;
&lt;FaButton Variant="FaButtonVariant.OutlineDanger"&gt;Outline danger&lt;/FaButton&gt;
&lt;FaButton Href="/reports" Variant="FaButtonVariant.Secondary"&gt;View reports&lt;/FaButton&gt;</code></pre>
</details>

<h2>FaCard</h2>
<p><code>Clickable</code> + <code>Active</code> for a selectable tile grid.</p>
<div class="fa-row fa-gap-2 fa-mb-4">
    @foreach (var option in _cardOptions)
    {
        <FaCard CssClass="fa-col-auto" Clickable="true" Active="@(_selectedCard == option)" OnClick="@(() => _selectedCard = option)">
            <strong>@option</strong>
        </FaCard>
    }
</div>

<h2>FaAlert</h2>
<div class="fa-mb-4">
    <FaAlert Variant="FaAlertVariant.Info">Info — heads up, nothing's wrong.</FaAlert>
    <FaAlert Variant="FaAlertVariant.Success">Success — that worked.</FaAlert>
    <FaAlert Variant="FaAlertVariant.Danger">Danger — something went wrong.</FaAlert>
</div>

<h2>FaBadge</h2>
<div class="fa-row fa-gap-2 fa-mb-4">
    <FaBadge Variant="FaBadgeVariant.Neutral">Neutral</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Primary">Primary</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Success">Paid</FaBadge>
    <FaBadge Variant="FaBadgeVariant.Danger">Overdue</FaBadge>
</div>

<h2>FaAvatar</h2>
<div class="fa-row fa-gap-2 fa-mb-4">
    <FaAvatar DisplayName="Jane Doe" />
    <FaAvatar DisplayName="A" />
    <FaAvatar />
</div>

<h2>FaModal</h2>
<p>Position, size, close behavior, and footer button alignment.</p>
<div class="fa-row fa-gap-2 fa-mb-4">
    <FaButton OnClick="@(() => _showCenterModal = true)">Center · Medium</FaButton>
    <FaButton OnClick="@(() => _showRightModal = true)">Right · Small · no backdrop close</FaButton>
    <FaButton OnClick="@(() => _showLargeModal = true)">Large · Between-aligned footer</FaButton>
</div>

<FaModal Show="_showCenterModal" Title="Confirm delete" OnClose="@(() => _showCenterModal = false)">
    <ChildContent>
        <p>Are you sure you want to delete this item? This can't be undone.</p>
    </ChildContent>
    <FooterContent>
        <FaButton Variant="FaButtonVariant.Outline" OnClick="@(() => _showCenterModal = false)">Cancel</FaButton>
        <FaButton Variant="FaButtonVariant.Danger" OnClick="@(() => _showCenterModal = false)">Delete</FaButton>
    </FooterContent>
</FaModal>

<FaModal Show="_showRightModal" Title="Filters" OnClose="@(() => _showRightModal = false)"
         Position="FaModalPosition.Right" Size="FaModalSize.Small"
         ShowCloseButton="false" CloseOnBackdropClick="false">
    <ChildContent>
        <p>This modal can only be closed from its own footer button — the header × is
           hidden and clicking the backdrop does nothing.</p>
    </ChildContent>
    <FooterContent>
        <FaButton OnClick="@(() => _showRightModal = false)">Close</FaButton>
    </FooterContent>
</FaModal>

<FaModal Show="_showLargeModal" Title="Archive item" OnClose="@(() => _showLargeModal = false)"
         Size="FaModalSize.Large" FooterAlign="FaAlign.Between">
    <ChildContent>
        <p>FooterAlign="Between" puts a destructive action on the left and Cancel/Confirm on the right, no manual spacer needed.</p>
    </ChildContent>
    <FooterContent>
        <FaButton Variant="FaButtonVariant.OutlineDanger" OnClick="@(() => _showLargeModal = false)">Delete instead</FaButton>
        <div class="fa-row fa-gap-2">
            <FaButton Variant="FaButtonVariant.Outline" OnClick="@(() => _showLargeModal = false)">Cancel</FaButton>
            <FaButton OnClick="@(() => _showLargeModal = false)">Archive</FaButton>
        </div>
    </FooterContent>
</FaModal>

@code {
    private readonly string[] _cardOptions = { "Starter", "Pro", "Enterprise" };
    private string _selectedCard = "Pro";

    private bool _showCenterModal;
    private bool _showRightModal;
    private bool _showLargeModal;
}
