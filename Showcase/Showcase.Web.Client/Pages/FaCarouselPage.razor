@page "/fa-carousel"
@inject HttpClient Http

<PageTitle>Carousel — FaFa Showcase</PageTitle>

<h1>Carousel</h1>
<p class="fa-mb-4">
    <code>FaCarousel</code>. Full parameter reference: <a href="https://github.com/parrescence/FaFa/blob/dev/Blazor/docs/fa-carousel.md" target="_blank">Blazor/docs/fa-carousel.md</a>.
    One-slide-at-a-time slideshow, in-memory or provider-backed.
</p>

<h2><code>Items</code> (in-memory)</h2>
<FaCarousel TItem="Product" Items="_localProducts">
    <ItemTemplate Context="product">
        <div style="padding: 1rem;">
            <h3>@product.Name</h3>
            <p>@product.Category · @product.Price.ToString("C")</p>
            <FaBadge Variant="@(product.InStock ? FaBadgeVariant.Success : FaBadgeVariant.Danger)">
                @(product.InStock ? "In stock" : "Out of stock")
            </FaBadge>
        </div>
    </ItemTemplate>
</FaCarousel>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Wrapper</span><code>.fa-carousel</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Viewport</span><code>.fa-carousel-viewport</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Arrows</span><code>.fa-carousel-arrow-prev</code> / <code>.fa-carousel-arrow-next</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Dot (active)</span><code>.fa-carousel-dot.fa-carousel-dot-active</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaCarousel TItem="Product" Items="_products"&gt;
    &lt;ItemTemplate Context="product"&gt;
        &lt;h3&gt;@@product.Name&lt;/h3&gt;
        &lt;p&gt;@@product.Price.ToString("C")&lt;/p&gt;
    &lt;/ItemTemplate&gt;
&lt;/FaCarousel&gt;</code></div>

<h2 class="fa-mt-5"><code>ItemsProvider</code> (from the database)</h2>
<p>Fetched once from <code>GET /api/products</code> when the carousel first renders.</p>
<FaCarousel TItem="Product" ItemsProvider="LoadAllProductsAsync" AutoPlay="true">
    <ItemTemplate Context="product">
        <div style="padding: 1rem;">
            <h3>@product.Name</h3>
            <p>@product.Category · @product.Price.ToString("C")</p>
        </div>
    </ItemTemplate>
</FaCarousel>
<div class="fa-code-block"><code>&lt;FaCarousel TItem="Product" ItemsProvider="LoadAllProductsAsync" AutoPlay="true"&gt;
    &lt;ItemTemplate Context="product"&gt;
        &lt;h3&gt;@@product.Name&lt;/h3&gt;
    &lt;/ItemTemplate&gt;
&lt;/FaCarousel&gt;

@@code {
    private async Task&lt;IReadOnlyList&lt;Product&gt;&gt; LoadAllProductsAsync() =&gt;
        await Http.GetFromJsonAsync&lt;List&lt;Product&gt;&gt;("/api/products") ?? new();
}</code></div>

@code {
    private sealed record Product(int Id, string Name, string Category, decimal Price, bool InStock);

    private readonly List<Product> _localProducts = new()
    {
        new(1, "Trail Runner Jacket", "Apparel", 129.99m, true),
        new(2, "Cedar Camp Mug", "Outdoor", 18.50m, true),
        new(3, "Alpine Wool Socks", "Apparel", 14.00m, true),
        new(4, "Folding Camp Stool", "Outdoor", 42.00m, false),
        new(5, "Rain Shell, Packable", "Apparel", 89.00m, true),
    };

    private async Task<IReadOnlyList<Product>> LoadAllProductsAsync()
    {
        var products = await Http.GetFromJsonAsync<List<Product>>("/api/products");
        return products ?? new List<Product>();
    }
}
