@namespace Showcase.Web.Client.Pages

@page "/fa-logout-form"

<DemoPageHeader Title="Logout Form" ComponentName="FaLogoutForm" DocSlug="fa-logout-form">
    "Are you sure?" confirm/cancel — typically dropped inside a small <code>FaModal</code>.
</DemoPageHeader>

<ComponentSubNav BaseRoute="/fa-logout-form" />

<FaButton OnClick="@(() => _showLogoutModal = true)">Log out</FaButton>
<FaModal Show="_showLogoutModal" Title="Log out" OnClose="@(() => _showLogoutModal = false)" Size="FaModalSize.Small">
    <FaLogoutForm OnConfirm="HandleLogoutAsync" OnCancel="@(() => _showLogoutModal = false)" />
</FaModal>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Wrapper</span><code>.fa-form.fa-logout-form</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Message</span><code>.fa-logout-message</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaModal Show="_showModal" Title="Log out" OnClose="@@(() => _showModal = false)" Size="FaModalSize.Small"&gt;
    &lt;FaLogoutForm OnConfirm="HandleLogoutAsync" OnCancel="@@(() => _showModal = false)" /&gt;
&lt;/FaModal&gt;</code></div>

@code {
    private bool _showLogoutModal;

    private Task HandleLogoutAsync()
    {
        _showLogoutModal = false;
        return Task.CompletedTask;
    }
}