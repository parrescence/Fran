@namespace Showcase.Web.Client.Pages

@page "/fa-radio-group/api"

<DemoPageHeader Title="Radio Group: API" ComponentName="FaRadioGroup&lt;TValue&gt;" DocSlug="fa-radio-group" />

<ComponentSubNav BaseRoute="/fa-radio-group" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Options</code></td><td><code>IReadOnlyList&lt;(string Title, TValue Value)&gt;</code></td><td>required — a plain tuple list, same shape as <code>FaToggle</code>'s</td></tr>
            <tr><td><code>Value</code> / <code>ValueChanged</code></td><td><code>TValue?</code></td><td><code>@@bind-Value</code></td></tr>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>Disabled</code></td><td><code>bool</code></td><td></td></tr>
            <tr><td><code>ReadOnly</code></td><td><code>bool</code></td><td>flattens to the selected option's title as plain text with a bottom border</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>
    No <code>AdditionalAttributes</code> splat on this component — every attribute
    you set is one of the above. No separate standalone <code>FaRadio</code>
    component — a lone radio button needs a shared <code>name</code> to belong to
    a group, and this component generates that once (a field initializer, not
    regenerated on every render) instead of asking callers to coordinate it
    themselves.
</p>
