@namespace Showcase.Web.Client.Pages

@page "/fa-logout-form/api"

<DemoPageHeader Title="Logout Form: API" ComponentName="FaLogoutForm" DocSlug="fa-logout-form" />

<ComponentSubNav BaseRoute="/fa-logout-form" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>OnConfirm</code></td><td><code>EventCallback</code></td><td>required — FaLogoutForm never signs anyone out itself, this is where the caller clears the session</td></tr>
            <tr><td><code>OnCancel</code></td><td><code>EventCallback</code></td><td>Cancel button only shows if this has a delegate</td></tr>
            <tr><td><code>Message</code></td><td><code>string</code></td><td>default <code>"Are you sure you want to log out?"</code></td></tr>
            <tr><td><code>ConfirmText</code></td><td><code>string</code></td><td>default <code>"Log out"</code></td></tr>
            <tr><td><code>CancelText</code></td><td><code>string</code></td><td>default <code>"Cancel"</code></td></tr>
            <tr><td><code>Busy</code></td><td><code>bool</code></td><td>disables Confirm, "Logging out…" text</td></tr>
            <tr><td><code>ButtonAlign</code></td><td><code>FaAlign</code></td><td><code>Start</code> · <code>Center</code> · <code>End</code> (default) · <code>Between</code> · <code>Around</code> · <code>Evenly</code></td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above.</p>
