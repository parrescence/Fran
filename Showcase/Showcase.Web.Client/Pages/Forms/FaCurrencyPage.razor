@namespace Showcase.Web.Client.Pages

@page "/fa-currency"

<DemoPageHeader Title="Currency Input" ComponentName="FaCurrency" DocSlug="fa-currency">
    <code>InputBase&lt;TValue&gt;</code>-derived — only works inside an <code>&lt;EditForm&gt;</code>.
</DemoPageHeader>

<ComponentSubNav BaseRoute="/fa-currency" />

<EditForm Model="_model" class="fa-form">
    <FaCurrency @bind-Value="_model.Budget" Label="Budget" Min="0" />
</EditForm>
<p>Value: <FaBadge>@(_model.Budget?.ToString("C") ?? "(none)")</FaBadge></p>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Wrapper</span><code>.fa-field</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Input</span><code>.fa-input.fa-currency-input</code></div>
</div>
<div class="fa-code-block"><code>&lt;EditForm Model="_model"&gt;
    &lt;FaCurrency @@bind-Value="_model.Budget" Label="Budget" Min="0" /&gt;
&lt;/EditForm&gt;</code></div>

<h2 class="fa-mt-5">Size &amp; responsive</h2>
<p><code>Size</code> is the shared <a href="/sizing">FaSize</a> scale — <code>Medium</code> (default) renders with no extra class. <code>Responsive="true"</code> stretches to 100% width below 720px.</p>
<EditForm Model="_model" class="fa-form">
    <FaCurrency @bind-Value="_model.Budget" Label="Small" Size="FaSize.Small" />
    <FaCurrency @bind-Value="_model.Budget" Label="Large" Size="FaSize.Large" />
</EditForm>
<div class="fa-code-block"><code>&lt;FaCurrency @@bind-Value="_model.Budget" Label="Budget" Size="FaSize.Small" /&gt;</code></div>

@code {
    private class DemoModel
    {
        public decimal? Budget { get; set; }
    }

    private DemoModel _model = new();
}