@namespace Showcase.Web.Client.Pages

@page "/fa-checkbox/api"

<DemoPageHeader Title="Checkbox: API" ComponentName="FaCheckbox" DocSlug="fa-checkbox" />

<ComponentSubNav BaseRoute="/fa-checkbox" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Value</code> / <code>ValueChanged</code></td><td><code>bool</code></td><td><code>@@bind-Value</code></td></tr>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td>clickable label text</td></tr>
            <tr><td><code>ReadOnly</code></td><td><code>bool</code></td><td>flattens to a plain ☑/☐ + label with a bottom border instead of a clickable checkbox</td></tr>
            <tr><td><code>ShowValidationMessage</code></td><td><code>bool</code></td><td>defaults <code>true</code> — see <a href="/validation">Validation</a></td></tr>
            <tr><td><code>Validate</code></td><td><code>Func&lt;bool, string?&gt;?</code></td><td>element-tier validation override</td></tr>
            <tr><td><code>ContainerCssClass</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>AdditionalAttributes</code></td><td>(inherited from <code>InputCheckbox</code>)</td><td>any attribute not listed above splats onto the <code>&lt;input type="checkbox"&gt;</code></td></tr>
        </tbody>
    </table>
</div>
