@namespace Showcase.Web.Client.Pages

@page "/sizing"

<DemoPageHeader Title="Sizing &amp; responsive" ComponentName="Sizing" DocSlug="sizing">
    Cross-cutting concepts, not a single component — like <a href="/validation">Validation</a>.
</DemoPageHeader>

<h2>Size (the FaSize scale)</h2>
<p>
    A shared five-step enum — <code>XSmall</code>/<code>Small</code>/<code>Medium</code> (default)/<code>Large</code>/<code>XLarge</code> —
    available as <code>Size</code> on <code>FaButton</code>, <code>FaInput</code>, <code>FaSelect</code>, <code>FaTextarea</code>,
    <code>FaCheckbox</code>, <code>FaCurrency</code>, <code>FaCard</code>, <code>FaAlert</code>, <code>FaBadge</code>, <code>FaChip</code>.
    <code>Medium</code> renders with no extra class — the exact look every one of these already had before <code>Size</code> existed.
</p>
<div class="fa-demo-preview">
    <FaButton Size="FaSize.XSmall">XSmall</FaButton>
    <FaButton Size="FaSize.Small">Small</FaButton>
    <FaButton>Medium</FaButton>
    <FaButton Size="FaSize.Large">Large</FaButton>
    <FaButton Size="FaSize.XLarge">XLarge</FaButton>
</div>
<div class="fa-code-block"><code>&lt;FaButton Size="FaSize.Small"&gt;Small&lt;/FaButton&gt;</code></div>

<h2 class="fa-mt-5">Responsive</h2>
<p>
    An opt-in <code>bool Responsive</code> on <code>FaButton</code>, <code>FaCard</code>, <code>FaInput</code>, <code>FaSelect</code>,
    <code>FaTextarea</code>, and <code>FaCurrency</code> — stretches to 100% width below 720px. Resize this window narrow to see it kick in.
</p>
<div class="fa-demo-preview">
    <FaButton Variant="FaButtonVariant.Primary" Responsive="true">Full-width on mobile</FaButton>
</div>
<div class="fa-code-block"><code>&lt;FaButton Variant="FaButtonVariant.Primary" Responsive="true"&gt;Submit&lt;/FaButton&gt;</code></div>

<h2 class="fa-mt-5">Floating label (FaInput only)</h2>
<p>
    <code>FaInput.FloatingLabel</code> renders <code>Label</code> overlaid inside the input, animating up on focus/fill,
    instead of a block label above the field. Pure CSS, no JS.
</p>
<EditForm Model="_model" class="fa-demo-preview" style="max-width:20rem;">
    <FaInput TValue="string" @bind-Value="_model.Email" Label="Email" FloatingLabel="true" />
</EditForm>
<div class="fa-code-block"><code>&lt;FaInput @@bind-Value="_model.Email" Label="Email" FloatingLabel="true" /&gt;</code></div>

<h2 class="fa-mt-5">Input style (standard / minimal / maximal)</h2>
<p>
    A third, app-wide axis — independent of <code>Size</code> above and of palette/theme mode — that retunes every boxed
    native-input-like control (<code>FaInput</code>/<code>FaSelect</code>/<code>FaTextarea</code>/<code>FaCurrency</code>) at once.
    Try it live — this affects every input on this page and across the whole Showcase:
</p>
<div class="fa-demo-preview">
    <FaInputStyleSwitcher />
</div>
<EditForm Model="_model" class="fa-demo-preview" style="max-width:20rem;">
    <FaInput TValue="string" @bind-Value="_model.Name" Label="Name" Placeholder="Try each style above" />
</EditForm>
<div class="fa-code-block"><code>&lt;FaInputStyleSwitcher /&gt;</code></div>
<p>See <a href="/input-style-switcher">FaInputStyleSwitcher</a> for the dedicated component page.</p>

@code {
    private readonly DemoModel _model = new();

    private class DemoModel
    {
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
