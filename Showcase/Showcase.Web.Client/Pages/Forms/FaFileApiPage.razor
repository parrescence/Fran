@namespace Showcase.Web.Client.Pages

@page "/fa-file/api"

<DemoPageHeader Title="File Upload: API" ComponentName="FaFile" DocSlug="fa-file" />

<ComponentSubNav BaseRoute="/fa-file" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>OnChange</code></td><td><code>EventCallback&lt;InputFileChangeEventArgs&gt;</code></td><td>same event args as the stock Blazor <code>InputFile</code> this wraps</td></tr>
            <tr><td><code>AsButton</code></td><td><code>bool</code></td><td>shows a styled <code>FaButton</code>-look button instead of the browser's default file input chrome</td></tr>
            <tr><td><code>ButtonLabel</code></td><td><code>string</code></td><td>default <code>"Choose file"</code>; ignored unless <code>AsButton</code> is set</td></tr>
            <tr><td><code>Multiple</code></td><td><code>bool</code></td><td>allows selecting more than one file</td></tr>
            <tr><td><code>CssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above.</p>
