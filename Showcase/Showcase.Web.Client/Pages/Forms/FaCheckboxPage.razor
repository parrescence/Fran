@namespace Showcase.Web.Client.Pages

@page "/fa-checkbox"

<DemoPageHeader Title="Checkbox" ComponentName="FaCheckbox" DocSlug="fa-checkbox">
    <code>InputBase&lt;TValue&gt;</code>-derived — only works inside an <code>&lt;EditForm&gt;</code>.
</DemoPageHeader>

<EditForm Model="_model" class="fa-form">
    <FaCheckbox @bind-Value="_model.Subscribe" Label="Subscribe to updates" />
</EditForm>
<p>Checked: <FaBadge>@_model.Subscribe</FaBadge></p>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Wrapper</span><code>.fa-checkbox</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Input</span><code>.fa-checkbox-input</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Label</span><code>.fa-checkbox-label</code> (clickable)</div>
</div>
<div class="fa-code-block"><code>&lt;EditForm Model="_model"&gt;
    &lt;FaCheckbox @@bind-Value="_model.Subscribe" Label="Subscribe to updates" /&gt;
&lt;/EditForm&gt;</code></div>

@code {
    private class DemoModel
    {
        public bool Subscribe { get; set; }
    }

    private DemoModel _model = new();
}