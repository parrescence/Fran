@namespace Showcase.Web.Client.Pages

@page "/validation"

@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<DemoPageHeader Title="Validation" ComponentName="FaFa.Validation" DocSlug="validation">
    Three tiers — root/DTO-level <code>IFaValidator&lt;TModel&gt;</code>, form-level
    <code>ConfigureValidation</code>, per-element <code>Validate</code> — most-specific
    wins. Plain C# throughout, no expression-tree rule DSL.
</DemoPageHeader>

<ValidationSubNav />

<div class="validation-index-grid">
    <FaCard CssClass="validation-index-card" Clickable="true" OnClick="@(() => Nav.NavigateTo("/validation/wiring"))">
        <h3>Wiring it up</h3>
        <p>
            Model → root validator → DI registration → page skeleton. Start here for
            a new model that doesn't have any FaFa validation on it yet.
        </p>
    </FaCard>
    <FaCard CssClass="validation-index-card" Clickable="true" OnClick="@(() => Nav.NavigateTo("/validation/usage"))">
        <h3>How to use</h3>
        <p>
            A live form exercising every rule shorthand — <code>Required</code>,
            <code>Between</code>, <code>EqualTo</code>, <code>MaxLength</code>,
            <code>Must</code> — across all three tiers, plus FaDate's own Min/Max
            check.
        </p>
    </FaCard>
    <FaCard CssClass="validation-index-card" Clickable="true" OnClick="@(() => Nav.NavigateTo("/validation/api"))">
        <h3>API reference</h3>
        <p>
            Every type, method, and parameter in <code>FaFa.Validation</code>, plus
            each input's validation parameters, in tables.
        </p>
    </FaCard>
</div>
