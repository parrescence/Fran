@namespace Showcase.Web.Client.Pages

@page "/fa-search-select"

<DemoPageHeader Title="Search Select" ComponentName="FaSearchSelect" DocSlug="fa-search-select">
    Plain <code>@@bind-Value</code> — works with or without an <code>EditForm</code>. Type-to-search combobox
    over your own query function (a real app would call an API, not filter an in-memory list).
</DemoPageHeader>

<div class="fa-demo-preview" style="max-width: 22rem;">
    <FaSearchSelect TItem="string" Label="Product" Placeholder="Type a product name…"
                    QueryAsync="SearchProductsAsync" ItemLabel="p => p" @bind-Value="_selectedProduct" />
</div>
<p>Selected: <FaBadge>@(_selectedProduct ?? "(none)")</FaBadge></p>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Wrapper</span><code>.fa-field</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Input</span><code>.fa-input.fa-searchselect-input</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Dropdown</span><code>.fa-searchselect-dropdown</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Option (highlighted)</span><code>.fa-searchselect-option.fa-searchselect-option-highlighted</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaSearchSelect TItem="string" Label="Product" Placeholder="Type a product name…"
                QueryAsync="SearchProductsAsync" ItemLabel="p => p" @@bind-Value="_selectedProduct" /&gt;

@@code {
    private Task&lt;IReadOnlyList&lt;string&gt;&gt; SearchProductsAsync(string query) =&gt;
        Http.GetFromJsonAsync&lt;List&lt;string&gt;&gt;($"/api/products/search?q={query}");
}</code></div>

@code {
    private readonly List<string> _productNames = new()
    {
        "Trail Runner Jacket", "Cedar Camp Mug", "Alpine Wool Socks", "Folding Camp Stool",
        "Rain Shell, Packable", "Titanium Spork", "Wool Beanie", "Camp Lantern, Solar",
        "Merino Base Layer", "Insulated Water Bottle", "Trekking Poles, Pair", "Fleece Vest"
    };

    private string? _selectedProduct;

    private Task<IReadOnlyList<string>> SearchProductsAsync(string query) =>
        Task.FromResult<IReadOnlyList<string>>(
            _productNames.Where(p => p.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList());
}