@namespace Showcase.Web.Client.Pages

@page "/fa-dropdown/api"

<DemoPageHeader Title="Dropdown: API" ComponentName="FaDropdown&lt;TItem&gt;" DocSlug="fa-dropdown" />

<ComponentSubNav BaseRoute="/fa-dropdown" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Items</code></td><td><code>IReadOnlyList&lt;TItem&gt;</code></td><td>the full local list to filter/select from; ignored when <code>QueryPageAsync</code> is set</td></tr>
            <tr><td><code>QueryPageAsync</code></td><td><code>Func&lt;string, int, int, Task&lt;(IReadOnlyList&lt;TItem&gt; Items, int TotalCount)&gt;&gt;?</code></td><td><code>(search, skip, take)</code> in, <code>(items, totalCount)</code> out — set instead of <code>Items</code> to back the dropdown with a database/API call, same "caller owns the data source" split as <code>FaGrid.ItemsProvider</code></td></tr>
            <tr><td><code>ItemLabel</code></td><td><code>Func&lt;TItem, string&gt;</code></td><td>required — text shown for an item; in local mode also what the contains-search matches against</td></tr>
            <tr><td><code>ItemTemplate</code></td><td><code>RenderFragment&lt;TItem&gt;?</code></td><td>optional custom row rendering; falls back to plain <code>ItemLabel</code> text</td></tr>
            <tr><td><code>Value</code> / <code>ValueChanged</code></td><td><code>TItem?</code></td><td><code>@@bind-Value</code></td></tr>
            <tr><td><code>SearchText</code> / <code>SearchTextChanged</code></td><td><code>string?</code></td><td><code>@@bind-SearchText</code></td></tr>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>Placeholder</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>NoResultsText</code></td><td><code>string</code></td><td>default <code>"No results"</code></td></tr>
            <tr><td><code>LoadingText</code></td><td><code>string</code></td><td>default <code>"Loading…"</code></td></tr>
            <tr><td><code>MaxVisibleItems</code></td><td><code>int</code></td><td>default <code>10</code> — how many rows show at once; also the page size passed to <code>QueryPageAsync</code></td></tr>
            <tr><td><code>DebounceMilliseconds</code></td><td><code>int</code></td><td>default <code>250</code>; ignored in local mode</td></tr>
            <tr><td><code>Searchable</code></td><td><code>bool</code></td><td>default <code>true</code> — type-to-filter combobox; <code>false</code> is a plain click-to-open dropdown, same interaction shape as a native <code>&lt;select&gt;</code></td></tr>
            <tr><td><code>ReadOnly</code></td><td><code>bool</code></td><td>flattens the field to the selected item's label as plain text with a bottom border</td></tr>
            <tr><td><code>ContainerCssClass</code></td><td><code>string?</code></td><td></td></tr>
        </tbody>
    </table>
</div>
<p>No <code>AdditionalAttributes</code> splat on this component — every attribute you set is one of the above. Scrolling (wheel or arrow keys) slides a window over the results rather than growing the dropdown or relying on native overflow scrolling.</p>
