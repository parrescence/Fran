@namespace Showcase.Web.Client.Pages

@page "/fa-input/api"

<DemoPageHeader Title="Text Input: API" ComponentName="FaInput&lt;TValue&gt;" DocSlug="fa-input" />

<ComponentSubNav BaseRoute="/fa-input" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Value</code> / <code>ValueChanged</code></td><td><code>TValue</code></td><td><code>@@bind-Value</code>, via <code>EditContext</code></td></tr>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>Placeholder</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>Type</code></td><td><code>string</code></td><td>HTML <code>type</code>, default <code>"text"</code></td></tr>
            <tr><td><code>Step</code></td><td><code>string?</code></td><td>for <code>type="number"</code></td></tr>
            <tr><td><code>ReadOnly</code></td><td><code>bool</code></td><td>same boxed look, muted and non-interactive</td></tr>
            <tr><td><code>ShowValidationMessage</code></td><td><code>bool</code></td><td>defaults <code>true</code> — see <a href="/validation">Validation</a></td></tr>
            <tr><td><code>Validate</code></td><td><code>Func&lt;TValue, string?&gt;?</code></td><td>element-tier validation override</td></tr>
            <tr><td><code>ContainerCssClass</code></td><td><code>string?</code></td><td>on the wrapping <code>.fa-field</code>, not the <code>&lt;input&gt;</code> itself</td></tr>
            <tr><td><code>AdditionalAttributes</code></td><td>(inherited from <code>InputBase&lt;TValue&gt;</code>)</td><td>any attribute not listed above splats straight onto the <code>&lt;input&gt;</code> — <code>id</code>, <code>data-*</code>, <code>aria-*</code>, <code>autocomplete</code>, etc.</td></tr>
        </tbody>
    </table>
</div>
