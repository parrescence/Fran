@namespace Showcase.Web.Client.Pages

@page "/fa-currency/api"

<DemoPageHeader Title="Currency Input: API" ComponentName="FaCurrency" DocSlug="fa-currency" />

<ComponentSubNav BaseRoute="/fa-currency" />

<div class="table-wrap">
    <table class="fa-table">
        <thead><tr><th>Parameter</th><th>Type</th><th>Notes</th></tr></thead>
        <tbody>
            <tr><td><code>Value</code> / <code>ValueChanged</code></td><td><code>decimal?</code></td><td><code>@@bind-Value</code></td></tr>
            <tr><td><code>Label</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>Min</code> / <code>Max</code></td><td><code>decimal?</code></td><td>clamps values as they're typed; shows a non-throwing inline range message if <code>Max</code> ends up below <code>Min</code> — see <a href="/validation">Validation</a></td></tr>
            <tr><td><code>CurrencySymbol</code></td><td><code>string</code></td><td>default <code>"$"</code></td></tr>
            <tr><td><code>ReadOnly</code></td><td><code>bool</code></td><td>same boxed look, muted and non-interactive</td></tr>
            <tr><td><code>ContainerCssClass</code></td><td><code>string?</code></td><td></td></tr>
            <tr><td><code>AdditionalAttributes</code></td><td>(inherited from <code>InputBase&lt;decimal?&gt;</code>)</td><td>any attribute not listed above splats onto the <code>&lt;input&gt;</code></td></tr>
        </tbody>
    </table>
</div>
<p>No JS interop — values are rounded to 2 decimal places on parse.</p>
