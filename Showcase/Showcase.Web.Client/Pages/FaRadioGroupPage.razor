@page "/fa-radio-group"

<PageTitle>Radio Group — FaFa Showcase</PageTitle>

<h1>Radio Group</h1>
<p class="fa-mb-4">
    <code>FaRadioGroup</code>. Full parameter reference: <a href="https://github.com/benzaesintese/FaFa/blob/dev/Blazor/docs/fa-radio-group.md" target="_blank">Blazor/docs/fa-radio-group.md</a>.
    Plain <code>@@bind-Value</code> — works with or without an <code>EditForm</code>.
</p>

<FaRadioGroup TValue="string" Label="Frequency" Options="_frequencyOptions" @bind-Value="_frequency" />
<p>Selected: <FaBadge>@_frequency</FaBadge></p>
<div class="fa-class-legend">
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Group</span><code>.fa-radio-group</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Each option</span><code>.fa-radio</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Input</span><code>.fa-radio-input</code></div>
    <div class="fa-class-legend-row"><span class="fa-class-legend-label">Label</span><code>.fa-radio-label</code></div>
</div>
<div class="fa-code-block"><code>&lt;FaRadioGroup TValue="string" Label="Frequency"
              Options="_frequencyOptions" @@bind-Value="_frequency" /&gt;

@@code {
    private string _frequency = "monthly";
    private IReadOnlyList&lt;(string Title, string Value)&gt; _frequencyOptions = new[]
    {
        ("Weekly", "weekly"),
        ("Monthly", "monthly"),
        ("Yearly", "yearly")
    };
}</code></div>

@code {
    private string _frequency = "monthly";
    private IReadOnlyList<(string Title, string Value)> _frequencyOptions = new[]
    {
        ("Weekly", "weekly"),
        ("Monthly", "monthly"),
        ("Yearly", "yearly")
    };
}
