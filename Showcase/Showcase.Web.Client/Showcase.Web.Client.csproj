<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />
  </ItemGroup>

  <!-- ProjectReference, not a GitHub Packages PackageReference — this is the
       in-repo showcase, so it always builds against the library's current source
       (dev's in-progress components included), not the last published version.
       A real consumer outside this repo follows Blazor/docs/install.md instead. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Blazor\Fran.csproj" />
  </ItemGroup>

</Project>
