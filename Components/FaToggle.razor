@* Segmented Yes/No switch — both options always visible, active one highlighted, same
   idea as ThemeSwitcher's row of buttons (not a single sliding knob). An optional
   companion input can show inline only while the toggle is on, sharing the same
   bordered group: compact (just the two buttons) while there's no input showing,
   and only then does the group expand to fill the field's width, with the input
   absorbing the extra space (see .fa-toggle-group-expanded in theme.css).
   Not InputBase-based (that requires an EditContext/EditForm, which nothing in this app
   uses yet — see FaSelect/FaInput) — plain two-way-bindable parameters instead, same
   pattern as FaButton/FaCard. Supports @bind-Value and @bind-InputValue. *@

<div class="fa-field @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="fa-label">@Label</label>
    }
    <div class="fa-toggle-group @(ShowInput ? "fa-toggle-group-expanded" : null)">
        @if (Value && InputType is not null && InputPosition == FaTogglePosition.Before)
        {
            <input class="fa-toggle-input fa-toggle-input-before" type="@InputType" placeholder="@InputPlaceholder"
                   value="@InputValue" disabled="@Disabled" @oninput="OnInputChanged" />
        }

        <div class="fa-toggle-switch" role="group" aria-label="@Label" @onkeydown="HandleKeyDown">
            <button type="button"
                    @ref="_offButtonRef"
                    class="fa-toggle-option @(!Value ? "fa-toggle-option-active" : null)"
                    aria-pressed="@(!Value ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => SetValueAsync(false)">
                @OffLabel
            </button>
            <button type="button"
                    @ref="_onButtonRef"
                    class="fa-toggle-option @(Value ? "fa-toggle-option-active" : null)"
                    aria-pressed="@(Value ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => SetValueAsync(true)">
                @OnLabel
            </button>
        </div>

        @if (Value && InputType is not null && InputPosition == FaTogglePosition.After)
        {
            <input class="fa-toggle-input" type="@InputType" placeholder="@InputPlaceholder"
                   value="@InputValue" disabled="@Disabled" @oninput="OnInputChanged" />
        }
    </div>
</div>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public string? InputValue { get; set; }
    [Parameter] public EventCallback<string?> InputValueChanged { get; set; }

    /// <summary>HTML input type (e.g. "text", "number") for the companion input. Null renders no input at all.</summary>
    [Parameter] public string? InputType { get; set; }
    [Parameter] public FaTogglePosition InputPosition { get; set; } = FaTogglePosition.After;
    [Parameter] public string? InputPlaceholder { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string OnLabel { get; set; } = "Yes";
    [Parameter] public string OffLabel { get; set; } = "No";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private bool ShowInput => Value && InputType is not null;

    private ElementReference _offButtonRef;
    private ElementReference _onButtonRef;

    private async Task SetValueAsync(bool newValue)
    {
        if (Disabled || Value == newValue)
            return;

        Value = newValue;
        await ValueChanged.InvokeAsync(Value);
    }

    // Left/right arrows move both the selection and focus together, same as a native
    // radio group — not just Tab between the two buttons.
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Disabled)
            return;

        switch (e.Key)
        {
            case "ArrowLeft":
                await SetValueAsync(false);
                await _offButtonRef.FocusAsync();
                break;
            case "ArrowRight":
                await SetValueAsync(true);
                await _onButtonRef.FocusAsync();
                break;
        }
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        InputValue = e.Value?.ToString();
        await InputValueChanged.InvokeAsync(InputValue);
    }
}
