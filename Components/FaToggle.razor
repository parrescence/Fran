@* Yes/No switch with an optional companion input shown inline only while the toggle
   is on — e.g. Transactions' "Paid by check?" toggle that reveals a check-number field.
   The Yes/No text lives inside the toggle button itself, and the whole control (toggle
   + input, when the input is showing) shares one bordered group instead of the input
   floating outside with its own separate border.
   Not InputBase-based (that requires an EditContext/EditForm, which nothing in this app
   uses yet — see FaSelect/FaInput) — plain two-way-bindable parameters instead, same
   pattern as FaButton/FaCard. Supports @bind-Value and @bind-InputValue. *@

<div class="fa-field @CssClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="fa-label">@Label</label>
    }
    <div class="fa-toggle-group">
        @if (Value && InputType is not null && InputPosition == FaTogglePosition.Before)
        {
            <input class="fa-toggle-input fa-toggle-input-before" type="@InputType" placeholder="@InputPlaceholder"
                   value="@InputValue" disabled="@Disabled" @oninput="OnInputChanged" />
        }

        <button type="button"
                class="fa-toggle @(Value ? "fa-toggle-on" : "fa-toggle-off")"
                role="switch"
                aria-checked="@(Value ? "true" : "false")"
                disabled="@Disabled"
                @onclick="ToggleAsync">
            <span class="fa-toggle-knob"></span>
            <span class="fa-toggle-label">@(Value ? OnLabel : OffLabel)</span>
        </button>

        @if (Value && InputType is not null && InputPosition == FaTogglePosition.After)
        {
            <input class="fa-toggle-input" type="@InputType" placeholder="@InputPlaceholder"
                   value="@InputValue" disabled="@Disabled" @oninput="OnInputChanged" />
        }
    </div>
</div>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    [Parameter] public string? InputValue { get; set; }
    [Parameter] public EventCallback<string?> InputValueChanged { get; set; }

    /// <summary>HTML input type (e.g. "text", "number") for the companion input. Null renders no input at all.</summary>
    [Parameter] public string? InputType { get; set; }
    [Parameter] public FaTogglePosition InputPosition { get; set; } = FaTogglePosition.After;
    [Parameter] public string? InputPlaceholder { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string OnLabel { get; set; } = "Yes";
    [Parameter] public string OffLabel { get; set; } = "No";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private async Task ToggleAsync()
    {
        if (Disabled)
            return;

        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        InputValue = e.Value?.ToString();
        await InputValueChanged.InvokeAsync(InputValue);
    }
}
