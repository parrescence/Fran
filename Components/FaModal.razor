@* Backdrop-covered dialog — first reusable modal in the app (prior "create X" flows were
   inline page forms). Backdrop click and the header's close button both invoke OnClose;
   the caller owns whether it's currently visible (no internal show/hide state) so it can
   gate the close behind unsaved-changes checks if it ever needs to. *@

@if (Show)
{
    <div class="fa-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="fa-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="fa-modal-header">
                <h5 class="fa-modal-title">@Title</h5>
                <button type="button" class="fa-modal-close" aria-label="Close" @onclick="() => OnClose.InvokeAsync()">×</button>
            </div>
            <div class="fa-modal-body">
                @ChildContent
            </div>
            @if (FooterContent is not null)
            {
                <div class="fa-modal-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    private Task HandleBackdropClick() => OnClose.InvokeAsync();
}
